# Public PortOne V2 identifiers for the existing NHN KCP identity-verification channel
PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Server-only secrets. Configure these in Vercel; never commit real values.
PORTONE_API_SECRET=replace-with-vercel-environment-secret
# Optional. If omitted, the server derives a separate session-signing key from PORTONE_API_SECRET.
AGE_SESSION_SECRET=replace-with-at-least-32-random-characters
